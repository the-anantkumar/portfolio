---
interface Props {
  kind: "trlr" | "codeforces" | "nielsen" | "portfolio";
}
const { kind } = Astro.props;
const outlines = {
  nielsen: {
    label: "Parallel validation",
    title: "Make the change measurable.",
    steps: [
      { title: "Compare", text: "Production and test outputs" },
      { title: "Check", text: "Quality checks across the evaluated rows" },
      { title: "Verify", text: "Parity and measured variances" },
    ],
    note: "A simplified view of one evaluated run. The case study explains the results and their scope.",
  },
  codeforces: {
    label: "The daily practice loop",
    title: "Less choosing. More practicing.",
    steps: [
      { title: "Your level", text: "A user's Codeforces rating" },
      { title: "One problem", text: "A personalized daily recommendation" },
      { title: "Keep going", text: "A practice calendar and solved-problem recognition" },
    ],
    note: "An outline of the published workflow, not a product screenshot or a user's activity.",
  },
  trlr: {
    label: "Product question → engineering work",
    title: "From conversation to a hypothesis.",
    steps: [
      { title: "Conversation", text: "Build context through a working experience" },
      { title: "Continuity", text: "Durable state, validation and recovery" },
      { title: "Evaluation", text: "Compare the product hypothesis against a baseline" },
    ],
    note: "A public outline of the work. The application is deployed; prediction superiority remains unvalidated.",
  },
};
const outline = kind === "portfolio" ? undefined : outlines[kind];
---

<figure class:list={["project-visual", `visual-${kind}`]}>
  {
    outline ? (
      <>
        <div class="visual-heading">
          <span class="visual-label">{outline.label}</span>
          <p class="visual-title">{outline.title}</p>
        </div>
        <ol class="workflow-steps">
          {outline.steps.map((step, index) => (
            <li>
              <span class="workflow-number" aria-hidden="true">0{index + 1}</span>
              <div>
                <strong>{step.title}</strong>
                <p>{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <figcaption>{outline.note}</figcaption>
      </>
    ) : (
      <>
        <div class="visual-heading">
          <span class="visual-label">One content source. Two ways to explore.</span>
          <p class="visual-title">Read the work. Ask for the evidence.</p>
        </div>
        <div class="portfolio-paths">
          <div class="portfolio-path">
            <span class="path-status">Built</span>
            <strong>The portfolio</strong>
            <p>Public Markdown → static HTML</p>
            <span class="path-detail">Read and navigate without JavaScript.</span>
          </div>
          <div class="portfolio-path">
            <span class="path-status">Built</span>
            <strong>Ask</strong>
            <p>Question → matching passages → original sources</p>
            <span class="path-detail">Word matching first. Meaning-based search is a separate opt-in.</span>
          </div>
          <div class="portfolio-path path-experimental">
            <span class="path-status">Experimental · optional</span>
            <strong>AI-selected answers</strong>
            <p>Retrieved passages → local selection → original quotations</p>
            <span class="path-detail">A separate model download. Selection quality is still under evaluation.</span>
          </div>
        </div>
        <figcaption>A public architecture outline. Questions stay on the device; the answer mode does not write new factual prose.</figcaption>
      </>
    )
  }
</figure>

<style>
  .project-visual {
    container-type: inline-size;
    margin: 0;
    padding: 0;
    width: 100%;
    color: var(--ink);
  }
  .visual-label {
    display: block;
    font: 500 var(--text-support)/1.6 var(--sans);
    color: var(--muted);
  }
  .visual-title {
    font: 600 calc(var(--text-body) * 1.25)/1.35 var(--display);
    letter-spacing: -0.025em;
    margin-top: var(--space-1);
    max-width: 26ch;
    text-wrap: balance;
  }
  .workflow-steps {
    list-style: none;
    margin: var(--space-3) 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }
  .workflow-steps li {
    min-width: 0;
    border-top: 1px solid var(--line);
    padding-top: var(--space-2);
  }
  .workflow-number {
    display: block;
    font: 500 var(--text-support)/1.5 var(--sans);
    color: var(--accent);
    margin-bottom: var(--space-1);
    font-variant-numeric: tabular-nums;
  }
  .workflow-steps strong {
    font: 600 var(--text-body)/1.4 var(--display);
  }
  .workflow-steps p {
    font-size: var(--text-support);
    line-height: 1.65;
    margin-top: var(--space-1);
    color: var(--muted);
  }
  figcaption {
    font-size: var(--text-support);
    line-height: 1.65;
    color: var(--muted);
    max-width: 62ch;
  }
  .portfolio-paths {
    margin: var(--space-3) 0;
    display: grid;
    gap: var(--space-3);
  }
  .portfolio-path {
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
  }
  .portfolio-path > strong {
    display: block;
    font: 600 var(--text-body)/1.4 var(--display);
    margin-block: var(--space-1);
  }
  .path-status {
    font: 500 var(--text-support)/1.5 var(--sans);
    color: var(--accent);
  }
  .portfolio-path p {
    font-size: var(--text-support);
    line-height: 1.65;
  }
  .path-detail {
    display: block;
    font-size: var(--text-support);
    line-height: 1.65;
    margin-top: var(--space-1);
    color: var(--muted);
  }
  .path-experimental {
    border-top-style: dashed;
  }
  @container (min-width: 600px) {
    .portfolio-paths {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @container (max-width: 360px) {
    .workflow-steps {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .workflow-steps li {
      display: grid;
      grid-template-columns: 26px minmax(0, 1fr);
      gap: var(--space-1);
      padding-block: var(--space-2);
    }
    .workflow-steps li:last-child {
      padding-bottom: 0;
    }
    .workflow-number {
      margin-top: 2px;
      margin-bottom: 0;
    }
    .workflow-steps p {
      margin-top: 4px;
    }
  }
</style>

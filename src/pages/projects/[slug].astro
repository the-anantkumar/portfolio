---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectVisual from "../../components/ProjectVisual.astro";
export async function getStaticPaths() {
  return (await getCollection("projects")).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}
interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const next =
  projects[
    (projects.findIndex((p) => p.id === project.id) + 1) % projects.length
  ];
---

<Base
  title={`${project.data.title} — Anant Kumar Srivastava`}
  description={project.data.summary}
>
  <article class="case wrap">
    <a class="back-link" href="/#work">← All selected work</a>
    <div class="case-header">
      <span class="eyebrow">{project.data.label}</span><h1>
        {project.data.title}
      </h1><p class="case-summary">{project.data.summary}</p><div
        class="case-facts"
      >
        <div><span>ROLE</span><p>{project.data.role}</p></div><div>
          <span>BUILT WITH</span><p>{project.data.stack.join(" · ")}</p>
        </div>{
          project.data.links.length > 0 && (
            <div>
              <span>EXPLORE</span>
              {project.data.links.map((link) => (
                <p>
                  <a class="text-link" href={link.url}>
                    {link.label} ↗
                  </a>
                </p>
              ))}
            </div>
          )
        }
      </div>
    </div>
    {
      project.data.highlights.length > 0 && (
        <div class="case-highlights" aria-label="Selected validation results">
          {project.data.highlights.map((highlight) => (
            <div>
              <strong>{highlight.value}</strong>
              <span>{highlight.label}</span>
            </div>
          ))}
        </div>
      )
    }
    <ProjectVisual kind={project.data.visual} />
    <div class="case-body">
      <nav class="case-toc" aria-label="In this case study">
        <span class="eyebrow">IN THIS CASE STUDY</span>{
          headings
            .filter((h) => h.depth === 2)
            .map((h) => <a href={`#${h.slug}`}>{h.text}</a>)
        }
      </nav><div class="prose case-content"><Content /></div>
    </div>
    <a class="next-project" href={`/projects/${next.id}/`}
      ><span class="eyebrow">NEXT CASE STUDY</span><span
        >{next.data.title} <span aria-hidden="true">↗</span></span
      ></a
    >
  </article>
</Base>

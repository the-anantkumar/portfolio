---
import { getCollection, getEntry, render } from "astro:content";
import GitHubSection from "../components/GitHubSection.astro";
import Base from "../layouts/Base.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import { withBase } from "../lib/paths";
const home = (await getEntry("pages", "home"))!;
const about = (await getEntry("pages", "about"))!;
const experience = (await getEntry("pages", "experience"))!;
const { Content: HomeContent } = await render(home);
const { Content: AboutContent } = await render(about);
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = projects.find((project) => project.id === "nielsen-data-systems")!;
const supporting = projects.filter((project) => project.id !== featured.id);
---

<Base>
  <section class="hero wrap" aria-labelledby="hero-heading">
    <div class="hero-identity">
      <h1 id="hero-heading">Anant Kumar<br />Srivastava<span aria-hidden="true">.</span></h1>
      <p class="hero-role">Software engineer &amp; founder</p>
    </div>
    <div class="hero-copy">
      <p class="hero-description">{home.data.intro}</p>
      <div class="hero-actions">
        <a class="text-link" href="#work">Explore the work <span aria-hidden="true">↓</span></a>
        <a class="text-link hero-ask" href={withBase("ask/")}>Ask about my work <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section id="work" class="work wrap section" aria-labelledby="work-heading">
    <div class="section-heading">
      <div>
        <h2 id="work-heading">Selected work</h2>
      </div><p>Production systems. Independent products. Decisions behind the work.</p>
    </div>
    <article class="featured-project">
      <div class="featured-copy">
        <span class="eyebrow">Featured · Employer work</span>
        <h3><a href={withBase(`projects/${featured.id}/`)}>{featured.data.title}</a></h3>
        <p>{featured.data.summary}</p>
        <a class="featured-evidence" href={withBase("projects/nielsen-data-systems/#parallel-validation-at-scale")}><strong>≈7M rows. 28 quality checks.</strong><span>My validation work in one parallel run, within a wider team.</span></a>
        <a class="text-link" href={withBase(`projects/${featured.id}/`)}>Explore the engineering <span aria-hidden="true">↗</span></a>
      </div>
      <ProjectVisual kind={featured.data.visual} />
    </article>
    <div class="project-list">
      {supporting.map((project, i) => (
        <article class:list={["project-row", { "portfolio-project": project.id === "portfolio" }]}>
          <span class="project-number" aria-hidden="true">0{i + 2}</span>
          <div class="project-title">
            <span class="project-role">{project.data.role}</span>
            <h3><a href={withBase(`projects/${project.id}/`)}>{project.data.title}</a></h3>
            {project.id === "portfolio" && <span class="project-status">This portfolio · Evolving project</span>}
          </div>
          <div class="project-copy">
            <p>{project.data.summary}</p>
            <span class="project-evidence">{project.data.evidence}</span>
            {project.id === "portfolio" && <p class="portfolio-state">Word and meaning search are built. AI passage selection is experimental.</p>}
            <a class="text-link" href={withBase(`projects/${project.id}/`)}>Read case study <span aria-hidden="true">↗</span><span class="sr-only">: {project.data.title}</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="ask-invitation wrap" aria-labelledby="ask-invitation-heading">
    <div><h2 id="ask-invitation-heading">Looking for something specific?</h2>
    <p>Ask a question and find the original evidence behind my work.</p></div>
    <a class="text-link" href={withBase("ask/")}>Ask about my work <span aria-hidden="true">↗</span></a>
  </section>

  <section
    id="experience"
    class="experience section"
    aria-labelledby="experience-heading"
  >
    <div class="wrap experience-grid">
      <div class="experience-heading">
        <h2 id="experience-heading">Experience</h2>
        <p>Backend engineering, developer tooling, and research software.</p>
        <div class="skill-groups"><h3>Working toolkit</h3><p>Python · Java · C++ · SQL<br />AWS · Airflow · Redis<br />Docker · Kubernetes · Terraform</p></div>
      </div><div class="timeline">
        {
          experience.data.roles?.map((role) => (
            <article class="experience-item">
              <>
                <span class="experience-date">{role.dates}</span>
                <h3>{role.company}</h3>
                <p class="experience-role">{role.role}</p>
                <p class="experience-focus">{role.focus}</p>
                <details class="experience-details">
                  <summary>Selected contributions</summary>
                  <ul>{role.points.map((point) => <li>{point}</li>)}</ul>
                </details>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="about"
    class="about wrap section"
    aria-labelledby="about-heading"
  >
    <div class="about-heading">
      <h2 id="about-heading">A little about me</h2>
      <p class="about-note">Engineering, mathematics,<br />and a musical ear.</p>
    </div><div class="about-copy prose">
      <AboutContent />
    </div>
  </section>

  <GitHubSection />

  <section
    id="contact"
    class="contact section"
    aria-labelledby="contact-heading"
  >
    <div class="wrap contact-grid">
      <div>
        <h2 id="contact-heading">Let’s talk.        </h2><div class="contact-intro"><HomeContent /></div>
      </div><div class="contact-links">
        <a href={`mailto:${home.data.email}`}
          ><span>Email me</span><span aria-hidden="true">↗</span></a
        ><a href={home.data.linkedin}
          ><span>Connect on LinkedIn</span><span aria-hidden="true">↗</span></a
        ><a href="#github"
          ><span>Explore my GitHub work</span><span aria-hidden="true">↑</span
          ></a
        >
      </div>
    </div>
  </section>
</Base>

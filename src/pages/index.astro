---
import { getCollection, getEntry, render } from "astro:content";
import GitHubSection from "../components/GitHubSection.astro";
import Base from "../layouts/Base.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import { withBase } from "../lib/paths";
const home = (await getEntry("pages", "home"))!;
const about = (await getEntry("pages", "about"))!;
const experience = (await getEntry("pages", "experience"))!;
const { Content: HomeContent } = await render(home);
const { Content: AboutContent } = await render(about);
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = projects.find((project) => project.id === "nielsen-data-systems")!;
const supporting = projects.filter((project) => project.id !== featured.id);
---

<Base>
  <section class="hero wrap" aria-labelledby="hero-heading">
    <div class="hero-intro">
      <span class="eyebrow"
        ><span class="status-dot"></span> SOFTWARE ENGINEER & FOUNDER</span
      ><span class="hero-edition">SELECTED WORK / 2026</span>
    </div>
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 id="hero-heading">
          {home.data.headline}<br /><em>{home.data.headlineAccent}</em>
        </h1><p class="hero-description">{home.data.intro}</p><div
          class="hero-actions"
        >
          <a class="button" href="#work"
            >Explore my work <span aria-hidden="true">↓</span></a
          ><a class="text-link hero-ask" href={withBase("ask/")}
            >Ask about my work <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
      <aside class="hero-note" aria-label="Engineering and product thinking">
        <div class="prism-stage" aria-hidden="true">
          <div class="prism-ring ring-a"></div><div class="prism-ring ring-b">
          </div><div class="prism-ring ring-c"></div>
          <svg class="prism" viewBox="0 0 360 320" fill="none">
            <defs
              ><linearGradient id="spectrum" x1="0" y1="0" x2="1" y2="1"
                ><stop stop-color="#b5aeff"></stop><stop
                  offset=".5"
                  stop-color="#efa8d3"></stop><stop
                  offset="1"
                  stop-color="#eab2a1"></stop></linearGradient
              ></defs
            >
            <path
              class="incoming-light"
              d="M0 202L148 158"
              stroke="#b4b8dc"
              stroke-width="1"></path>
            <path
              d="M177 79L102 216H253L177 79Z"
              stroke="url(#spectrum)"
              stroke-width="1.5"></path>
            <path d="M148 158L212 146" stroke="#f0d9ef" stroke-width="1"></path>
            <path
              d="M212 146L360 161M215 151L360 180M218 156L360 199M221 161L360 218M224 166L360 237"
              stroke="url(#spectrum)"
              stroke-width="1.5"></path>
          </svg>
          <span class="prism-coordinate coordinate-top">ENGINEERING</span><span
            class="prism-coordinate coordinate-bottom">MEETS IMAGINATION</span
          >
        </div>
      </aside>
    </div>
    <div class="hero-bottom">
      <a href={withBase("projects/nielsen-data-systems/#parallel-validation-at-scale")}>
        <strong>≈7M rows. 28 checks.</strong>
        <span>My validation work at Nielsen, in one parallel <span class="keep-together">run <span aria-hidden="true">↗</span></span></span>
      </a>
      <p>Backend systems <span>/</span> Cloud infrastructure <span>/</span> Product engineering</p>
    </div>
  </section>

  <section id="work" class="work wrap section" aria-labelledby="work-heading">
    <div class="section-heading">
      <div>
        <span class="eyebrow">01 / SELECTED WORK</span><h2 id="work-heading">From systems to products.</h2>
      </div><p>Production engineering, independent products,<br />and the decisions behind them.</p>
    </div>
    <article class="featured-project">
      <div class="featured-copy">
        <span class="eyebrow">FEATURED / EMPLOYER WORK</span>
        <h3><a href={withBase(`projects/${featured.id}/`)}>{featured.data.title}</a></h3>
        <p>{featured.data.summary}</p>
        <span class="project-role">{featured.data.role}</span>
        <p class="featured-scope">Validation, migration safeguards, and workload automation within a wider engineering team.</p>
        <a class="text-link" href={withBase(`projects/${featured.id}/`)}>Explore the engineering <span aria-hidden="true">↗</span></a>
      </div>
      <ProjectVisual kind={featured.data.visual} />
    </article>
    <div class="project-list">
      {supporting.map((project, i) => (
        <article class:list={["project-row", { "portfolio-project": project.id === "portfolio" }]}>
          <span class="project-number" aria-hidden="true">0{i + 2}</span>
          <div class="project-title">
            <span class="project-role">{project.data.role}</span>
            <h3><a href={withBase(`projects/${project.id}/`)}>{project.data.title}</a></h3>
            {project.id === "portfolio" && <span class="project-status">YOU’RE HERE · EVOLVING PROJECT</span>}
          </div>
          <div class="project-copy">
            <p>{project.data.summary}</p>
            <span class="project-evidence">{project.data.evidence}</span>
            {project.id === "portfolio" && <p class="portfolio-state">Word and meaning search are built. AI passage selection is experimental.</p>}
            <a class="text-link" href={withBase(`projects/${project.id}/`)}>Read case study <span aria-hidden="true">↗</span><span class="sr-only">: {project.data.title}</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="ask-invitation wrap" aria-labelledby="ask-invitation-heading">
    <div><span class="eyebrow">A DIFFERENT WAY IN</span><h2 id="ask-invitation-heading">Follow your curiosity.</h2>
    <p>Ask about my engineering, founder work, or a project decision. Find the original evidence and go deeper.</p></div>
    <a class="button" href={withBase("ask/")}>Ask about my work <span aria-hidden="true">↗</span></a>
  </section>

  <section
    id="experience"
    class="experience section"
    aria-labelledby="experience-heading"
  >
    <div class="wrap experience-grid">
      <div class="experience-heading">
        <span class="eyebrow">02 / EXPERIENCE</span><h2 id="experience-heading">
          Engineering,<br /><em>in practice.</em>
        </h2><p>
          Learning through production constraints, research questions, and the
          details that make software dependable.
        </p><div class="skill-groups">
          <span>MY TOOLKIT</span><p>
            Python · Java · C++ · SQL<br />AWS · Airflow · Redis<br />Docker ·
            Kubernetes · Terraform
          </p>
        </div>
      </div><div class="timeline">
        {
          experience.data.roles?.map((role) => (
            <article class="experience-item">
              <>
                <span class="experience-date">{role.dates}</span>
                <h3>{role.company}</h3>
                <p class="experience-role">{role.role}</p>
                <ul>
                  {role.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="about"
    class="about wrap section"
    aria-labelledby="about-heading"
  >
    <div class="about-heading">
      <span class="eyebrow">03 / THE PERSON BEHIND THE WORK</span><h2
        id="about-heading"
      >
        A little more<br /><em>than code.</em>
      </h2><p class="about-note">Engineering mind.<br />Musical ear.</p>
    </div><div class="about-copy prose">
      <AboutContent />
    </div>
  </section>

  <GitHubSection />

  <section
    id="contact"
    class="contact section"
    aria-labelledby="contact-heading"
  >
    <div class="wrap contact-grid">
      <div>
        <span class="eyebrow">04 / WHAT’S NEXT?</span><h2 id="contact-heading">
          Have a good problem?<br /><em>Let’s build something.</em>
        </h2><div class="contact-intro"><HomeContent /></div>
      </div><div class="contact-links">
        <a href={`mailto:${home.data.email}`}
          ><span>Email me</span><span aria-hidden="true">↗</span></a
        ><a href={home.data.linkedin}
          ><span>Connect on LinkedIn</span><span aria-hidden="true">↗</span></a
        ><a href="#github"
          ><span>Explore my GitHub work</span><span aria-hidden="true">↑</span
          ></a
        ><p>No forms. Just a conversation.</p>
      </div>
    </div>
  </section>
</Base>

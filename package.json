{
  "name": "anant-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build && node scripts/write-release.mjs && node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "serve": "astro preview --host 127.0.0.1",
    "test": "npm run test:github && node scripts/verify-build.mjs",
    "test:github": "node --test scripts/refresh-github.test.mjs",
    "refresh:github": "node scripts/refresh-github.mjs",
    "test:browser": "node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.13.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3"
  }
}
